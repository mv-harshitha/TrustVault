# Copy this file to server/.env and replace placeholders locally. Never commit server/.env.
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string. Keep the database name "trustvault" before the query string.
# Atlas database users authenticate against the "admin" database, so keep authSource=admin.
# URL-encode special characters in the password (for example @ becomes %40).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/trustvault?retryWrites=true&w=majority&authSource=admin
# Local MongoDB alternative for offline development:
# MONGODB_URI=mongodb://127.0.0.1:27017/trustvault

JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
# Per-process limit for unauthenticated requests to document routes.
UNAUTH_DOCUMENT_AUDIT_LIMIT=30
UNAUTH_DOCUMENT_AUDIT_WINDOW_MS=900000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_BUCKET=trustvault-private
